# Configuration for ironrdp-server.service.
#
# NOTE: the IronRDP server skeleton authenticates with a single fixed
# credential pair passed on the command line, so the password lives here.
# Keep this file readable by root only (it is installed as mode 0600) and
# change the password before exposing the service.

# Address the RDP listener binds to.  The upstream default is 127.0.0.1:3389
# (loopback only); 0.0.0.0:3389 serves the network.
IRONRDP_BIND_ADDR=0.0.0.0:3389

# TLS identity, generated by the RPM on first install.
IRONRDP_CERT=/var/lib/ironrdp-server/cert.pem
IRONRDP_KEY=/var/lib/ironrdp-server/key.pem

# Security: hybrid (TLS + CredSSP/NLA, the upstream default) or tls.
IRONRDP_SEC=hybrid

IRONRDP_USER=ironrdp
IRONRDP_PASSWORD=ironrdp

# tracing filter for the daemon (off, error, warn, info, debug, trace)
IRONRDP_LOG=info
